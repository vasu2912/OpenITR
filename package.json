		"validate": "pnpm typecheck && pnpm test && pnpm build"
	},
	"devDependencies": {
		"@types/react": "19.2.18",
		"@types/react-dom": "19.2.4",
		"@vitejs/plugin-react": "6.1.0",
		"typescript": "7.0.2",
		"vite": "8.2.2",
		"vitest": "4.1.11"
	}
}
